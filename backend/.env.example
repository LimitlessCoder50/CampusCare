# Supabase Configuration
# Replace these with your actual Supabase project settings:
# Project Settings -> API in your Supabase Dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Supabase JWT Secret (found in Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-jwt-secret

# Application Settings
PROJECT_NAME="CampusCare API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS Settings (comma-separated or JSON list of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
